# Copia este archivo como .env y ajusta tus credenciales de MySQL.
# El archivo .env NUNCA se sube al repositorio (está en .gitignore).

PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contraseña_de_mysql
DB_NAME=ecommercefluterg1

# Clave secreta para firmar los tokens JWT (cámbiala en producción)
JWT_SECRET=cambia_esta_clave_secreta
